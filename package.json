{
  "name": "agent-usage-stat",
  "productName": "Agent Usage Stat",
  "version": "3.0.2",
  "description": "A private desktop application for Claude Code, Codex, and Copilot CLI usage analytics",
  "private": true,
  "license": "MIT",
  "author": "Yiliang Shao",
  "contributors": [
    "Chris Hutchinson <github.com/chrishutchinson> (original author)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiliangs/agent-usage-stat.git"
  },
  "bugs": {
    "url": "https://github.com/yiliangs/agent-usage-stat/issues"
  },
  "homepage": "https://github.com/yiliangs/agent-usage-stat#readme",
  "type": "module",
  "main": "./dist/desktop/main.js",
  "scripts": {
    "build": "node scripts/build-app.mjs",
    "start": "npm run build && electron-forge start",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "install:local": "npm run package && node scripts/install-local.mjs",
    "dev": "tsc --watch",
    "data": "node portal/scripts/build-data.mjs",
    "dev:portal": "npm run build && npm run data && vite --config portal/vite.config.ts",
    "preview:portal": "vite preview --config portal/vite.config.ts --port 4173",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:desktop": "npm run build && node scripts/test-desktop.mjs"
  },
  "keywords": [
    "claude-code",
    "codex",
    "github-copilot",
    "openai",
    "usage",
    "analytics",
    "dashboard",
    "ai",
    "desktop",
    "electron"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cross-spawn": "^7.0.6",
    "ora": "^9.1.0",
    "prompts": "^2.4.2",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.1.0",
    "@types/prompts": "^2.4.9",
    "electron": "^43.3.0",
    "esbuild": "^0.28.1",
    "lucide": "^1.31.0",
    "png-to-ico": "^3.0.2",
    "postject": "^1.0.0-alpha.6",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  }
}
